# Copy this file to .env and fill in your Firebase project's web app config.
# Get these from the Firebase console: Project settings → General → "Your apps"
# → the web app (</>) → SDK setup and configuration. These values are public
# by design (they ship inside the browser bundle) — the real security
# boundary is the server verifying each request's ID token, not secrecy of
# these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

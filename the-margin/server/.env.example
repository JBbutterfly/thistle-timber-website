# Copy this file to .env and fill in your key.
#
# Get an API key at https://console.anthropic.com/settings/keys
# (requires an Anthropic Console account with billing set up).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — port the local server listens on.
PORT=5175

# Optional — override the Claude model used for provocations.
# CLAUDE_MODEL=claude-opus-5

# Optional — set BOTH to require an HTTP Basic Auth login for the whole app.
# Only needed if this server is reachable over the public internet (e.g. a
# hosted deployment for testing on another device); leave unset for local use.
# APP_USER=margin
# APP_PASSWORD=choose-something-only-you-know

# Copy this file to .env and fill in your keys.

# Optional — a fallback key used only for accounts that haven't added their
# own in Settings yet. Each user is meant to bring their own Anthropic key
# (get one at https://console.anthropic.com/settings/keys); leave this unset
# in a real multi-user deployment so BYOK is the only path.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — port the local server listens on.
PORT=5175

# Optional — override the Claude model used for provocations.
# CLAUDE_MODEL=claude-opus-5

# --- Required ---

# Encrypts users' saved Anthropic keys at rest. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# The server verifies who's signed in and reads/writes their drafts using
# the Firebase Admin SDK, which needs a service account key. See the README
# ("Firebase project setup") for how to create the project and get this key.
#
# Option A — paste the whole downloaded service-account JSON file as one line
# here (works on hosts like Render that only offer environment variables):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
#
# Option B — for local dev, point at the downloaded JSON file instead:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

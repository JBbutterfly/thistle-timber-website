# Copy to .env and edit. Everything here is optional.

# Who can reach the app:
#   127.0.0.1  -> only this computer (default, safest)
#   0.0.0.0    -> phones and laptops on your home Wi-Fi too
HOMEBOOK_HOST=127.0.0.1
HOMEBOOK_PORT=8420

# Where the database, photos and backups live.
# HOMEBOOK_DATA_DIR=./data

# Photo recognition (receipts, product photos). Leave empty to keep everything local.
# Get a key at https://console.anthropic.com. Photos are sent only when you tap Receipt/Product photo.
ANTHROPIC_API_KEY=
HOMEBOOK_AI_MODEL=claude-sonnet-5

# Look up names for unknown barcodes on Open Food/Beauty/Products Facts.
# Sends only the barcode number. Set false to stay fully offline.
HOMEBOOK_PRODUCT_LOOKUP=true

# Set true only when you serve over HTTPS (e.g. Tailscale serve).
HOMEBOOK_SECURE_COOKIES=false
HOMEBOOK_SESSION_DAYS=30
